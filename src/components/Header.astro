---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE, SITE_TAGLINE } from '../consts';
---

<header>
	<nav>
		<div class="nav-brand">
			<h2><a href="/">{SITE_TITLE}</a></h2>
			<p class="tagline">{SITE_TAGLINE}</p>
		</div>
		
		<!-- Mobile Menu Toggle -->
		<button class="mobile-menu-toggle" aria-label="Toggle menu">
			<span></span>
			<span></span>
			<span></span>
		</button>
		
		<div class="nav-menu">
			<div class="internal-links">
				<HeaderLink href="/">Trang chủ</HeaderLink>
				<HeaderLink href="/blog">Bài viết</HeaderLink>
				<HeaderLink href="/about">Về chúng tôi</HeaderLink>
				<HeaderLink href="/contact">Liên hệ</HeaderLink>
			</div>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
		position: sticky;
		top: 0;
		z-index: 100;
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 1200px;
		margin: 0 auto;
		padding: 0.8em 0;
		position: relative;
	}

	.nav-brand h2 {
		margin: 0 0 0.1em 0;
		font-size: 1.4em;
		font-weight: 800;
		font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
		letter-spacing: -0.02em;
	}

	.nav-brand .tagline {
		margin: 0;
		font-size: 0.75em;
		font-weight: 400;
		color: #888;
		font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
	}

	.nav-brand a,
	.nav-brand a.active {
		text-decoration: none;
		color: #667eea;
		transition: all 0.3s ease;
	}

	.nav-brand a:hover {
		color: #5a6fd8;
		transform: translateY(-1px);
	}

	/* Mobile Menu Toggle */
	.mobile-menu-toggle {
		display: none;
		flex-direction: column;
		justify-content: space-around;
		width: 30px;
		height: 30px;
		background: transparent;
		border: none;
		cursor: pointer;
		padding: 0;
		z-index: 10;
	}

	.mobile-menu-toggle span {
		width: 100%;
		height: 3px;
		background: #333;
		border-radius: 2px;
		transition: all 0.3s ease;
		transform-origin: center;
	}

	.mobile-menu-toggle.active span:nth-child(1) {
		transform: rotate(45deg) translate(6px, 6px);
	}

	.mobile-menu-toggle.active span:nth-child(2) {
		opacity: 0;
	}

	.mobile-menu-toggle.active span:nth-child(3) {
		transform: rotate(-45deg) translate(6px, -6px);
	}

	.nav-menu {
		display: flex;
		align-items: center;
		gap: 2em;
	}

	.internal-links {
		display: flex;
		gap: 1.5em;
	}

	.internal-links a {
		padding: 0.6em 1.2em;
		color: #333;
		text-decoration: none;
		font-weight: 600;
		font-size: 0.95em;
		font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
		letter-spacing: -0.01em;
		border-radius: 8px;
		transition: all 0.3s ease;
		position: relative;
	}

	.internal-links a::before {
		content: '';
		position: absolute;
		bottom: 0;
		left: 50%;
		width: 0;
		height: 2px;
		background: linear-gradient(135deg, #667eea, #764ba2);
		transition: all 0.3s ease;
		transform: translateX(-50%);
	}

	.internal-links a:hover::before {
		width: 80%;
	}

	.internal-links a:hover {
		background: rgba(102, 126, 234, 0.08);
		color: #667eea;
		transform: translateY(-1px);
	}

	.internal-links a.active {
		background: rgba(102, 126, 234, 0.12);
		color: #667eea;
	}

	.internal-links a.active::before {
		width: 80%;
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	/* Mobile Styles */
	@media (max-width: 768px) {
		header {
			padding: 0 12px;
		}

		nav {
			padding: 0.8em 0;
		}

		.nav-brand h2 {
			font-size: 1.3em;
		}

		.mobile-menu-toggle {
			display: flex;
			width: 32px;
			height: 32px;
		}

		.mobile-menu-toggle span {
			height: 3px;
		}

		.nav-menu {
			position: fixed;
			top: 0;
			right: -100%;
			width: 320px;
			height: 100vh;
			background: white;
			box-shadow: -8px 0 32px rgba(0, 0, 0, 0.15);
			flex-direction: column;
			justify-content: flex-start;
			align-items: stretch;
			padding: 90px 0 0;
			transition: right 0.4s cubic-bezier(0.4, 0, 0.2, 1);
			z-index: 99;
		}

		.nav-menu.active {
			right: 0;
		}

		.internal-links {
			flex-direction: column;
			gap: 0;
			margin-bottom: 2em;
			padding: 0 2em;
		}

		.internal-links a {
			padding: 1.2em 0;
			font-size: 1.2em;
			font-weight: 600;
			border-bottom: 1px solid #f0f0f0;
			border-radius: 0;
			text-align: left;
			transition: all 0.3s ease;
		}

		.internal-links a::before {
			display: none;
		}

		.internal-links a:hover {
			background: rgba(102, 126, 234, 0.1);
			transform: translateX(8px);
			color: #667eea;
		}

		.internal-links a.active {
			background: rgba(102, 126, 234, 0.12);
			color: #667eea;
		}

	}

	@media (max-width: 480px) {
		header {
			padding: 0 8px;
		}

		.nav-brand h2 {
			font-size: 1.2em;
		}

		.nav-menu {
			width: 100%;
			right: -100%;
		}

		.internal-links {
			padding: 0 1.5em;
		}

		.internal-links a {
			font-size: 1.15em;
			padding: 1em 0;
		}

	}

	@media (max-width: 360px) {
		.nav-brand h2 {
			font-size: 1.1em;
		}

		.internal-links a {
			font-size: 1.1em;
		}
	}

	/* Overlay for mobile menu */
	@media (max-width: 768px) {
		.nav-menu::before {
			content: '';
			position: fixed;
			top: 0;
			left: 0;
			width: 100vw;
			height: 100vh;
			background: rgba(0, 0, 0, 0.5);
			z-index: -1;
			opacity: 0;
			transition: opacity 0.3s ease;
		}

		.nav-menu.active::before {
			opacity: 1;
		}
	}
</style>

<script>
	// Mobile menu toggle functionality
	document.addEventListener('DOMContentLoaded', function() {
		const mobileToggle = document.querySelector('.mobile-menu-toggle');
		const navMenu = document.querySelector('.nav-menu');
		
		if (mobileToggle && navMenu) {
			mobileToggle.addEventListener('click', function() {
				mobileToggle.classList.toggle('active');
				navMenu.classList.toggle('active');
				document.body.style.overflow = navMenu.classList.contains('active') ? 'hidden' : '';
			});

			// Close menu when clicking on links
			const navLinks = document.querySelectorAll('.internal-links a');
			navLinks.forEach(link => {
				link.addEventListener('click', function() {
					mobileToggle.classList.remove('active');
					navMenu.classList.remove('active');
					document.body.style.overflow = '';
				});
			});

			// Close menu when clicking outside
			document.addEventListener('click', function(e) {
				if (!navMenu.contains(e.target) && !mobileToggle.contains(e.target)) {
					mobileToggle.classList.remove('active');
					navMenu.classList.remove('active');
					document.body.style.overflow = '';
				}
			});
		}
	});
</script>
