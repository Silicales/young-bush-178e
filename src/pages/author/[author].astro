---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, AUTHOR_NAME, AUTHOR_SLUG, CONTACT_EMAIL_PRIMARY } from '../../consts';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
	return [
		{ params: { author: 'hieu-cao' } }
	];
}

const { author } = Astro.params;
const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="vi">
	<head>
		<BaseHead 
			title={`${AUTHOR_NAME} - Tác giả - ${SITE_TITLE}`} 
			description={`Thông tin về tác giả ${AUTHOR_NAME} và các bài viết của tác giả trên ${SITE_TITLE}`} 
		/>
	</head>
	<body>
		<Header />
		<main>
			<div class="container">
				<article class="author-content">
					<div class="author-header">
						<div class="author-avatar">
							<div class="avatar-placeholder">
								{AUTHOR_NAME.charAt(0)}
							</div>
						</div>
						<div class="author-info">
							<h1>{AUTHOR_NAME}</h1>
							<p class="author-title">Tác giả và Quản trị viên</p>
							<p class="author-bio">
								<em>[Phần giới thiệu này cần được tác giả bổ sung. Hãy thêm thông tin về bản thân, kinh nghiệm, 
								lĩnh vực chuyên môn, và những điều bạn muốn chia sẻ với độc giả.]</em>
							</p>
							<div class="author-contact">
								<a href={`mailto:${CONTACT_EMAIL_PRIMARY}`} class="contact-button">
									📧 Liên hệ
								</a>
							</div>
						</div>
					</div>

					<div class="author-stats">
						<div class="stat-card">
							<div class="stat-number">{posts.length}</div>
							<div class="stat-label">Bài viết</div>
						</div>
						<div class="stat-card">
							<div class="stat-number">2024</div>
							<div class="stat-label">Năm bắt đầu</div>
						</div>
					</div>

					<div class="author-posts">
						<h2>Bài viết gần đây</h2>
						<div class="posts-grid">
							{posts.slice(0, 6).map((post) => (
								<a href={`/blog/${post.slug}/`} class="post-card">
									<div class="post-image">
										{post.data.heroImage && (
											<img src={post.data.heroImage} alt={post.data.title} />
										)}
									</div>
									<div class="post-info">
										<h3>{post.data.title}</h3>
										<p class="post-excerpt">{post.data.description}</p>
										<time class="post-date">
											{new Date(post.data.pubDate).toLocaleDateString('vi-VN', {
												year: 'numeric',
												month: 'long',
												day: 'numeric'
											})}
										</time>
									</div>
								</a>
							))}
						</div>
						{posts.length > 6 && (
							<div class="view-all">
								<a href="/blog" class="view-all-button">Xem tất cả bài viết →</a>
							</div>
						)}
					</div>
				</article>
			</div>
		</main>
		<Footer />

		<style>
			.container {
				max-width: 1100px;
				margin: 0 auto;
				padding: 40px 20px;
			}

			.author-content {
				background: white;
				padding: 40px;
				border-radius: 10px;
				box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
			}

			.author-header {
				display: flex;
				gap: 40px;
				margin-bottom: 40px;
				padding-bottom: 40px;
				border-bottom: 2px solid #f0f0f0;
			}

			.author-avatar {
				flex-shrink: 0;
			}

			.avatar-placeholder {
				width: 150px;
				height: 150px;
				border-radius: 50%;
				background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
				display: flex;
				align-items: center;
				justify-content: center;
				font-size: 4rem;
				font-weight: bold;
				color: white;
			}

			.author-info {
				flex: 1;
			}

			.author-info h1 {
				margin: 0 0 10px 0;
				font-size: 2.5rem;
				color: #333;
			}

			.author-title {
				margin: 0 0 20px 0;
				font-size: 1.2rem;
				color: #667eea;
				font-weight: 600;
			}

			.author-bio {
				margin: 0 0 20px 0;
				font-size: 1.05rem;
				line-height: 1.7;
				color: #666;
			}

			.author-contact {
				margin-top: 20px;
			}

			.contact-button {
				display: inline-block;
				padding: 12px 30px;
				background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
				color: white;
				text-decoration: none;
				border-radius: 25px;
				font-weight: 600;
				transition: all 0.3s ease;
			}

			.contact-button:hover {
				transform: translateY(-2px);
				box-shadow: 0 6px 16px rgba(102, 126, 234, 0.4);
			}

			.author-stats {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
				gap: 20px;
				margin-bottom: 40px;
			}

			.stat-card {
				background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
				padding: 25px;
				border-radius: 12px;
				text-align: center;
				border: 2px solid #e0e0e0;
			}

			.stat-number {
				font-size: 2.5rem;
				font-weight: bold;
				color: #667eea;
				margin-bottom: 5px;
			}

			.stat-label {
				font-size: 1rem;
				color: #666;
			}

			.author-posts h2 {
				margin-bottom: 30px;
				font-size: 2rem;
				color: #333;
			}

			.posts-grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
				gap: 25px;
				margin-bottom: 30px;
			}

			.post-card {
				display: block;
				background: #f8f9fa;
				border-radius: 12px;
				overflow: hidden;
				text-decoration: none;
				transition: all 0.3s ease;
				box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
			}

			.post-card:hover {
				transform: translateY(-5px);
				box-shadow: 0 8px 20px rgba(102, 126, 234, 0.2);
			}

			.post-image {
				width: 100%;
				height: 180px;
				overflow: hidden;
				background: #e0e0e0;
			}

			.post-image img {
				width: 100%;
				height: 100%;
				object-fit: cover;
			}

			.post-info {
				padding: 20px;
			}

			.post-info h3 {
				margin: 0 0 10px 0;
				font-size: 1.2rem;
				color: #333;
			}

			.post-excerpt {
				margin: 0 0 10px 0;
				font-size: 0.95rem;
				color: #666;
				line-height: 1.5;
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}

			.post-date {
				font-size: 0.9rem;
				color: #999;
			}

			.view-all {
				text-align: center;
				margin-top: 30px;
			}

			.view-all-button {
				display: inline-block;
				padding: 12px 30px;
				background: white;
				color: #667eea;
				border: 2px solid #667eea;
				text-decoration: none;
				border-radius: 25px;
				font-weight: 600;
				transition: all 0.3s ease;
			}

			.view-all-button:hover {
				background: #667eea;
				color: white;
			}

			@media (max-width: 768px) {
				.container {
					padding: 20px 10px;
				}

				.author-content {
					padding: 25px 20px;
				}

				.author-header {
					flex-direction: column;
					gap: 25px;
					align-items: center;
					text-align: center;
				}

				.avatar-placeholder {
					width: 120px;
					height: 120px;
					font-size: 3rem;
				}

				.author-info h1 {
					font-size: 2rem;
				}

				.posts-grid {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</body>
</html>
